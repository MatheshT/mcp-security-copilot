# Backend environment variables
LLM_PROVIDER=free
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
WAZUH_API_URL=https://192.168.56.101:55000
WAZUH_API_KEY=
WAZUH_USERNAME=wazuh
WAZUH_PASSWORD=wazuh
WAZUH_AUTOMATION_ENABLED=true
WAZUH_AUTOMATION_MODE=dry_run
WAZUH_AUTOMATION_INTERVAL_SECONDS=300
WAZUH_AUTOMATION_MAX_PER_RUN=10
VIRUSTOTAL_API_KEY=
MISP_API_URL=https://misp.example.com
MISP_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
DEFAULT_SECURITY_TOOLS=Wazuh,VirusTotal,MISP,Shodan

# Database Configuration
DATABASE_URL=sqlite:///./security_copilot.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/security_copilot
# For MySQL: DATABASE_URL=mysql://user:password@localhost/security_copilot

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# Monitoring Configuration
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Frontend environment variable
VITE_API_URL=http://127.0.0.1:8000
